<div class="rbook-sidebar-search" id="sidebar-search-box" hidden>
    <label for="sidebar-search">搜索目录</label>
    <div class="rbook-sidebar-search__field">
        <input id="sidebar-search" type="search" placeholder="标题或分类，如 附录 脚本" autocomplete="off" spellcheck="false" aria-controls="sidebar-results" />
        <button id="sidebar-search-clear" type="button" aria-label="清空搜索" hidden>×</button>
    </div>
    <p id="sidebar-search-status" role="status" aria-live="polite" aria-atomic="true">搜索文章标题或目录路径</p>
</div>
