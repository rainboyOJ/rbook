{
    "version": "1.0.0",
    "author": "rainboy <rainboylvx@qq.com>",
    "license": "MIT",
    "name": "Rbook-algorithms_book",
    "source": "src/index.html",
    "bin": {
        "rbook": "./bin/rbook.js"
    },
    "scripts": {
        "predev": "npm run prepare",
        "dev": "vite dev --host",
        "build": "npm run typecheck:animations && vite build",
        "start": "http-server dist",
        "prepare": "tsc -p tsconfig.publishing.json",
        "typecheck": "tsc --noEmit && npm run typecheck:packages && npm run typecheck:animations",
        "typecheck:packages": "npm run typecheck --workspaces --if-present",
        "typecheck:animations": "tsc -p tsconfig.animations.json",
        "test": "npm run test:root && npm run test:packages",
        "test:root": "node --test tests/",
        "test:packages": "npm run test --workspaces --if-present",
        "render:fixture": "node tests/run-fixture.js",
        "check:catalog": "node tests/check-catalog.js",
        "build:core": "tsc -p tsconfig.publishing.json && node .tsbuild/publishing/cli/index.js build --profile core",
        "build:full": "tsc -p tsconfig.publishing.json && node .tsbuild/publishing/cli/index.js build --profile full",
        "dist:manifest": "node scripts/dist-manifest.cjs dist .tsbuild/before.json",
        "dist:diff": "node scripts/dist-diff.cjs .tsbuild/before.json .tsbuild/after.json",
        "gen:leetcodecn-slugs": "node scripts/gen-leetcodecn-slugs.cjs",
        "migrate:macros": "node scripts/migrate-ejs-macros.cjs"
    },
    "dependencies": {
        "ejs": "^3.1.9",
        "lokijs": "^1.5.12",
        "markdown-it": "^14.1.0",
        "markdown-it-texmath": "^1.0.0",
        "mkdirp": "^3.0.1",
        "prismjs": "^1.30.0",
        "twemoji": "^14.0.2"
    },
    "devDependencies": {
        "@iconify/vue": "^4.1.2",
        "@parcel/transformer-sass": "2.10.1",
        "@popperjs/core": "^2.11.8",
        "@rollup/rollup-darwin-arm64": "^4.63.2",
        "@types/ejs": "^3.1.5",
        "@types/js-yaml": "^4.0.9",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^26.4.1",
        "@types/prismjs": "^1.26.6",
        "@vitejs/plugin-vue": "^5.0.4",
        "archiver": "^7.0.1",
        "bootstrap": "^5.3.3",
        "commander": "^12.0.0",
        "fuse.js": "^7.0.0",
        "js-yaml": "^4.1.0",
        "jsonc-parser": "^3.2.1",
        "katex": "^0.16.10",
        "markdown-it-container": "^4.0.0",
        "milligram": "^1.4.1",
        "parcel": "^2.10.1",
        "parcel-transformer-ejs": "^1.0.1",
        "sass": "^1.76.0",
        "typescript": "^5.5.4",
        "vis-network": "^9.1.9",
        "vite": "^5.2.11",
        "vite-plugin-ejs": "^1.7.0",
        "vue": "^3.4.26",
        "vue-toastification": "^2.0.0-rc.5"
    },
    "packageManager": "npm@11.19.0",
    "workspaces": [
        "packages/*"
    ]
}
