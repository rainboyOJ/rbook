digraph G {
    rankdir=LR;
    bgcolor="transparent";
    node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", fontname="sans-serif", fontsize=11];
    edge [color="#64748b", fontname="sans-serif", fontsize=10];

    subgraph cluster_0 {
        label="初始状态";
        bgcolor="#ffffff";
        style="dashed,rounded";
        color="#cbd5e1";
        q0 [label="队列: [ 1 ]\ndis: [0, ∞, ∞, ∞, ∞]"];
    }

    subgraph cluster_1 {
        label="第 1 步：取出点 1";
        bgcolor="#ffffff";
        style="dashed,rounded";
        color="#cbd5e1";
        q1 [label="松弛 2: dis[2]=5\n松弛 3: dis[3]=2\n队列: [ 2, 3 ]\ndis: [0, 5, 2, ∞, ∞]"];
    }

    subgraph cluster_2 {
        label="第 2 步：取出点 2";
        bgcolor="#ffffff";
        style="dashed,rounded";
        color="#cbd5e1";
        q2 [label="松弛 4: dis[4]=7\n队列: [ 3, 4 ]\ndis: [0, 5, 2, 7, ∞]"];
    }

    subgraph cluster_3 {
        label="第 3 步：取出点 3 (再次入队)";
        bgcolor="#ffffff";
        style="dashed,rounded";
        color="#cbd5e1";
        q3 [label="松弛 2: dis[2]=2+(-4)=-2 < 5\n点 2 距离变小，重新入队！\n队列: [ 4, 2 ]\ndis: [0, -2, 2, 7, ∞]"];
    }

    subgraph cluster_4 {
        label="第 4 步：取出 4，再取 2";
        bgcolor="#ffffff";
        style="dashed,rounded";
        color="#cbd5e1";
        q4 [label="点 2 再次通知邻居\n松弛 4: dis[4]=-2+2=0 < 7\n队列: [ 4 ] -> 最终清空\ndis: [0, -2, 2, 0, ∞]"];
    }

    q0 -> q1 -> q2 -> q3 -> q4;
}
