digraph dfs_order_seq {
    rankdir=TB;
    bgcolor="transparent";
    dpi=160;
    ranksep=0.2;
    nodesep=0.2;
    node [shape=plaintext, fontname="sans-serif"];

    seq [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="10" color="#94a3b8">
            <tr>
                <td border="0" align="right"><font point-size="12" color="#64748b">位置 i</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">1</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">2</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">3</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">4</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">5</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">6</font></td>
                <td bgcolor="#f8fafc"><font point-size="11" color="#64748b">7</font></td>
            </tr>
            <tr>
                <td border="0" align="right"><font point-size="12" color="#64748b">order[i]</font></td>
                <td><font point-size="15">1</font></td>
                <td bgcolor="#dbeafe" color="#2563eb" border="2"><font point-size="15" color="#1e40af"><b>2</b></font></td>
                <td bgcolor="#dbeafe" color="#2563eb" border="2"><font point-size="15" color="#1e40af"><b>4</b></font></td>
                <td bgcolor="#dbeafe" color="#2563eb" border="2"><font point-size="15" color="#1e40af"><b>5</b></font></td>
                <td bgcolor="#dbeafe" color="#2563eb" border="2"><font point-size="15" color="#1e40af"><b>7</b></font></td>
                <td><font point-size="15">3</font></td>
                <td><font point-size="15">6</font></td>
            </tr>
        </table>
    >];

    note [label=<<font point-size="13" color="#2563eb">子树 2 恰好占住 order[2..5]</font>>];
    seq -> note [style=invis];
}
