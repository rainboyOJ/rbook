digraph dfs_order_tree {
    rankdir=TB;
    bgcolor="transparent";
    node [shape=circle, style="filled", fillcolor="#f8fafc", color="#475569", penwidth=1.5,
          fontname="sans-serif", fontsize=12, fontcolor="#0f172a", width=0.62, fixedsize=false];
    edge [color="#94a3b8", penwidth=1.3];
    dpi=160;
    ranksep=0.38;
    nodesep=0.32;

    0 [label=<<b>1</b><br/><font point-size="10" color="#64748b">[1,7]</font>>];
    1 [label=<<b>2</b><br/><font point-size="10" color="#2563eb">[2,5]</font>>,
       fillcolor="#dbeafe", color="#2563eb", penwidth=2];
    2 [label=<<b>3</b><br/><font point-size="10" color="#64748b">[6,7]</font>>];
    3 [label=<<b>4</b><br/><font point-size="10" color="#2563eb">[3,3]</font>>,
       fillcolor="#dbeafe", color="#2563eb", penwidth=2];
    4 [label=<<b>5</b><br/><font point-size="10" color="#2563eb">[4,5]</font>>,
       fillcolor="#dbeafe", color="#2563eb", penwidth=2];
    5 [label=<<b>6</b><br/><font point-size="10" color="#64748b">[7,7]</font>>];
    6 [label=<<b>7</b><br/><font point-size="10" color="#2563eb">[5,5]</font>>,
       fillcolor="#dbeafe", color="#2563eb", penwidth=2];

    0 -> 1 [color="#2563eb", penwidth=2, arrowhead=none];
    0 -> 2 [arrowhead=none];
    1 -> 3 [color="#2563eb", penwidth=2, arrowhead=none];
    1 -> 4 [color="#2563eb", penwidth=2, arrowhead=none];
    4 -> 6 [color="#2563eb", penwidth=2, arrowhead=none];
    2 -> 5 [arrowhead=none];

    { rank=same; 3; 4; 5; }
    { rank=same; 6; }
}
